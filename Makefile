# Makefile — единая точка входа для всех проверок и команд проекта.
#
# Зачем он нужен: команды запуска линтеров, тестов и сканеров должны быть
# одинаковыми на вашей машине, у меня и в CI. Если они расходятся, появляется
# классическая ситуация «у меня локально зелено, а в CI красно» — и доверие
# к проверкам пропадает.
#
# ВАЖНО про текущее состояние (шаг 1 этапа 1):
# целей `lint`, `test` и `security` здесь ПОКА НЕТ. Это сделано намеренно.
# Правила проекта запрещают проверки, которые ничего не проверяют, но
# показывают «успех». Пустая цель `security`, печатающая «OK», — это ровно
# такая фальшивая зелёная галочка. Поэтому `make lint` сейчас честно скажет
# "No rule to make target 'lint'", а цели появятся вместе с настоящими
# проверками на шагах 2-6.

# Без аргументов показываем справку, а не запускаем случайную первую цель
.DEFAULT_GOAL := help

# .PHONY говорит make, что это имена команд, а не имена файлов.
# Без этого `make test` сломается в тот день, когда в корне появится
# файл или каталог с именем `test` — make решит, что цель уже собрана.
.PHONY: help

help: ## Показать список доступных команд
	@echo "Web-Deception — доступные команды:"
	@echo ""
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) \
		| awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-18s\033[0m %s\n", $$1, $$2}'
	@echo ""
	@echo "Появятся по ходу этапа 1:"
	@echo "  lint               линтеры и форматтеры Go и Python   (шаги 2-3)"
	@echo "  test               unit-тесты с порогом покрытия      (шаги 2-3)"
	@echo "  dev                поднять весь стек локально         (шаг 4)"
	@echo "  security           gitleaks, semgrep, govulncheck,"
	@echo "                     pip-audit, trivy                   (шаг 6)"

# .gitignore — список того, что git не берёт в коммит.
#
# ВАЖНО: это НЕ мера безопасности. Файл только снижает вероятность случайности.
# Секреты от попадания в репозиторий защищают gitleaks в CI и push protection
# GitHub (шаг 6). Если секрет уже попал в историю — его нужно считать
# скомпрометированным и отозвать, удаление коммита не помогает.

# --- Секреты и локальная конфигурация -------------------------------------
# Реальные значения живут здесь и никогда не коммитятся; в репозитории
# хранится только .env.example с безопасными заглушками.
.env
.env.*
!.env.example

# Секреты docker compose, создаются командой `make secrets`
deploy/compose/secrets/

# Закрытые ключи и сертификаты. Для mTLS между сенсором и control plane
# (этап 3) их будет много. Тестовые фикстуры при необходимости добавляются
# явно через `git add -f` — то есть осознанно.
*.pem
*.key
*.p12
*.pfx

# --- Go --------------------------------------------------------------------
/bin/
sensor/sensor
*.exe
*.test
# Файлы покрытия и профилирования
*.out
coverage.*

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
# Кэши линтеров и тестов: содержат результаты прошлых запусков,
# в репозитории от них только конфликты
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# --- Сборка ----------------------------------------------------------------
/dist/
/build/

# --- Окружение разработчика ------------------------------------------------
# Личные настройки редактора и ОС: у каждого свои, в общий репозиторий не нужны
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.claude/settings.local.json

module github.com/azuresong-afk/web_deception/sensor

// Минимальная версия Go.
//
// Go выпускает исправления безопасности только для двух последних версий.
// Сенсор стоит в критическом пути чужого трафика, поэтому он обязан собираться
// поддерживаемой версией. Изначально здесь стояла 1.24 — версия, которая
// к моменту начала проекта уже не получала патчей; ошибка найдена на шаге 4
// при выборе базового образа для сборки.
//
// Патч-версию не фиксируем: точную версию сборки задаёт образ golang,
// закреплённый по digest в deploy/docker/sensor.Dockerfile.
go 1.27.0

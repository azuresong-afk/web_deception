# Образ сенсора.
#
# Строки "# syntax=docker/dockerfile:1" в начале файла намеренно нет.
# Она заставляет сборщик скачать с Docker Hub образ-интерпретатор Dockerfile
# по плавающему тегу — то есть незакреплённый чужой код, исполняемый при
# каждой сборке. Встроенного интерпретатора нам хватает.
#
# Сборка в две стадии (multi-stage). Первая содержит компилятор Go,
# исходники и всё, что нужно для сборки. Вторая получает из неё один файл —
# готовый бинарник. В итоговом образе нет ни компилятора, ни исходного кода,
# ни shell.

# ---------------------------------------------------------------- сборка ---
# Образ закреплён по digest: тег "1.27-trixie" его владелец может в любой
# момент переписать на другое содержимое, digest — нет. Тег оставлен рядом
# для читаемости и для Dependabot, который будет предлагать обновления.
FROM golang:1.27-trixie@sha256:433790e515d27dc6003e847e644cc0af956985cf315c1c58a3b73ee2dd305183 AS build

WORKDIR /src

# Пустой каталог для файла событий. Создаётся в стадии сборки, потому что
# в итоговом образе нет shell и mkdir там выполнить нельзя. Стоит до COPY:
# слой не пересобирается при каждой правке кода.
RUN mkdir -p /out/events

# Сначала только описание модуля: когда появятся зависимости, их скачивание
# закешируется отдельным слоем и не будет повторяться при каждой правке кода.
COPY sensor/go.mod ./

COPY sensor/ ./

# Версия подставляется снаружи: make передаёт хеш коммита или тег.
ARG VERSION=dev

# CGO_ENABLED=0 — полностью статический бинарник без зависимости от libc.
# Без этого он не запустится в distroless/static, где libc нет.
# -trimpath убирает из бинарника пути к исходникам на машине сборки.
# -s -w убирают таблицы отладки: образ меньше, а трассировки паник Go
# при этом сохраняются.
RUN CGO_ENABLED=0 go build \
        -trimpath \
        -ldflags "-s -w -X github.com/azuresong-afk/web_deception/sensor/internal/version.Version=${VERSION}" \
        -o /out/sensor \
        ./cmd/sensor

# -------------------------------------------------------------- рантайм ---
# distroless/static — минимальный образ: сертификаты CA, часовые пояса,
# файл /etc/passwd с пользователем nonroot. Нет shell, пакетного менеджера,
# curl. Атакующий, получивший выполнение кода внутри контейнера, не найдёт
# здесь инструментов, чтобы развить атаку.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3

COPY --from=build /out/sensor /sensor

# Каталог событий принадлежит пользователю сенсора, права 0700: в событиях
# адреса клиентов, читать их может только сам сенсор (ADR-0023). Корень
# файловой системы в compose только для чтения, поэтому на этот каталог
# монтируется том — Docker создаёт его из каталога образа с тем же
# владельцем и правами.
COPY --from=build --chown=65532:65532 --chmod=0700 /out/events /var/lib/sensor

# Пользователь указан числом, а не именем "nonroot". Kubernetes с настройкой
# runAsNonRoot проверяет UID до запуска контейнера и не может проверить имя,
# не заглядывая внутрь образа, — поэтому образ с именем там не запустится.
USER 65532:65532

# Проверка готовности выполняется самим бинарником: curl в образе нет.
# Служебный слушатель по умолчанию на 127.0.0.1:9090, и это работает,
# потому что проверка выполняется внутри того же контейнера.
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/sensor", "healthcheck"]

ENTRYPOINT ["/sensor"]
